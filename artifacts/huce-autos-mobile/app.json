{
  "expo": {
    "name": "Huce Automart",
    "slug": "huce-automart-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "huceautos",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#195A32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.huceautomart.mobile"
    },
    "android": {
      "package": "com.huceautomart.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#195A32"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "apiBaseUrl": "https://api.huceautomart.com/api",
      "eas": {
        "projectId": "9500fcc2-b56d-4230-8851-e83a9124e7af"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "zenofund"
  }
}
